[Unit]
Description=Dash system monitoring agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/dash/agent.env
ExecStart=/usr/local/bin/dash-agent
Restart=always
RestartSec=5

# Reads /proc, /sys, and (if present) the Docker socket.
ProtectHome=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
