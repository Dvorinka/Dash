# syntax=docker/dockerfile:1

# Minimal dash-agent image. A containerized agent only sees its own /proc —
# run with --pid=host and -v /proc:/host/proc for host metrics, or prefer the
# systemd unit in packaging/.
FROM golang:1.27-alpine AS build
WORKDIR /src
COPY apps/backend/go.mod apps/backend/go.sum ./
RUN go mod download
COPY apps/backend ./
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/dash-agent ./cmd/dash-agent

FROM gcr.io/distroless/static-debian12
COPY --from=build /out/dash-agent /dash-agent
ENTRYPOINT ["/dash-agent"]
