# deps / builds
node_modules/
apps/frontend/dist/
packages/api-client/dist/
packages/api-client/src/schema.d.ts
apps/backend/internal/web/dist/*
!apps/backend/internal/web/dist/.keep

# data / runtime
data/*
!data/.keep
*.db
*.db-*

# env / secrets
.env
.env.*

# misc
.DS_Store
coverage/
dist/
# the blanket dist/ above excludes the embedded-UI dir itself, which would
# make the .keep negation unreachable — re-include the dir, contents stay ignored
!apps/backend/internal/web/dist/

# local tooling artifacts
.playwright-mcp/
.playwright-cli/
